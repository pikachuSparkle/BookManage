# Copy to .env.local and chmod 600 .env.local. Never commit real passwords.
DB_URL='jdbc:mysql://127.0.0.1:3307/bookmanage?connectionTimeZone=UTC&characterEncoding=UTF-8'
DB_USER=bookmanage
DB_PASSWORD='replace-with-a-random-database-password'
# Only needed when initializing a fresh database. Remove it afterwards.
ADMIN_PASSWORD='replace-with-a-random-admin-password'
APP_HOST=127.0.0.1
APP_PORT=8080
APP_CONTEXT_PATH=
